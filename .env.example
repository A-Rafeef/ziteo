# Copy to .env.local. Never commit actual credentials. Separate staging/production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: Supabase secret key (or legacy service_role key).
SUPABASE_SECRET_KEY=

# Auth secret must ALSO be configured in Supabase dashboard CAPTCHA settings.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,127.0.0.1

# Private R2 bucket; disable r2.dev/public domain. Restrict token to this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ziteo-images
# Optional: separately published public origin only, never private draft R2.
NEXT_PUBLIC_CLOUDFLARE_IMAGES_ORIGIN=
NEXT_PUBLIC_PUBLIC_IMAGE_ORIGIN=

# Configure Resend SMTP in Supabase separately for confirmation/reset mail.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Publish verification, not login. WhatsApp requires approved vendor contract.
TWOFACTOR_API_KEY=
TWOFACTOR_SMS_TEMPLATE=

# Opt-in analytics/replay. Mask inputs and private sections.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_REPLAY_ENABLED=false

# Exact source-specific ingestion hostname from Better Stack.
BETTER_STACK_INGESTING_HOST=
BETTER_STACK_SOURCE_TOKEN=

# Sandbox until paid lifecycle/webhook checks pass. Plan/price are server-owned.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01
CASHFREE_PLAN_ID=
CASHFREE_PLAN_AMOUNT=
CASHFREE_PLAN_PERIOD_MONTHS=1

# Controlled migration workflow only, never public/browser.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Optional Windows/local build compatibility; leave unset on Vercel.
ZITEO_SERIAL_BUILD=false
